{
    "name": "phpgraph/phpgraph",
    "type": "library",
    "description": "PHP Graphing Library that creates graphs natively in PHP",
    "keywords": ["graph","graphs", "graphing", "gd"],
    "homepage": "http://github.com/phpgraph/phpgraph",
    "license": "MIT",
    "require": {
        "php": "^7.3 || ^8.0",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "7.3.0"
        }
    },
    "autoload": {
        "psr-4": {
            "PhpGraph\\": "src/"
        }
    },
    "archive": {
        "exclude": ["/tests"]
    }
}
